<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Stock Information</title>
</head>
<body>
    <h1>Stock Information</h1>
    <form id="stockForm">
        <label for="stockCode">Enter Stock Code:</label>
        <input type="text" id="stockCode" name="stockCode" required>
        <button type="button" onclick="getStockInfo()">Submit</button>
    </form>
    <div id="resultPanel"></div>

    <script>
        async function getStockInfo() {
            const stockCode = document.getElementById("stockCode").value;

            try {
                const response = await fetch(`https://finance.yahoo.com/quote/${stockCode}`);
                const text = await response.text();

                // Parse the HTML response using DOMParser or other methods
                const parser = new DOMParser();
                const htmlDoc = parser.parseFromString(text, 'text/html');

                // Extract information from the parsed HTML
                const companyName = htmlDoc.querySelector('h1[data-reactid="7"]').textContent;
                const currentPrice = htmlDoc.querySelector('span[data-reactid="50"]').textContent;
                const openPrice = htmlDoc.querySelector('span[data-reactid="68"]').textContent;
                const endPrice = htmlDoc.querySelector('span[data-reactid="76"]').textContent;

                // Display the information on the page
                document.getElementById("resultPanel").innerHTML = `
                    <p><strong>Company Name:</strong> ${companyName}</p>
                    <p><strong>Current Price:</strong> ${currentPrice}</p>
                    <p><strong>Open Price Today:</strong> ${openPrice}</p>
                    <p><strong>End Price Today:</strong> ${endPrice}</p>
                `;
            } catch (error) {
                console.error('Error:', error);
            }
        }
    </script>
</body>
</html>
